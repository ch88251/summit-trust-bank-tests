{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@framework": ["./framework/index.ts"]
    }
  },
  "include": ["playwright.config.ts", "framework/**/*.ts", "tests/**/*.ts"]
}
