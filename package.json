{
  "name": "summit-bank-test-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI and API tests for the Summit Trust Bank sample application",
  "scripts": {
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "env:clean": "docker compose down -v",
    "env:logs": "docker compose logs -f app",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  }
}
